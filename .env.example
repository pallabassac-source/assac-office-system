# ==========================================================
# Assam State Space Application Centre (ASSAC)
# Intranet Attendance & Governance System - Environment Config
# ==========================================================

# Port Configuration
FRONTEND_PORT=80
BACKEND_PORT=5000

# Node Environment
NODE_ENV=production

# Security & Secrets
JWT_SECRET=assac_production_super_secret_key_2026

# Storage Paths (Inside Container)
DB_DIR=/app/data
UPLOADS_DIR=/app/uploads

# Optional: SMTP Mail Configuration (leave empty for mock mode)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=notifications@assac.assam.gov.in
# SMTP_PASS=your_email_password
# SMTP_FROM=ASSAC Notifications <notifications@assac.assam.gov.in>
