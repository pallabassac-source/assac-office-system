# ==========================================================
# Assam State Space Application Centre (ASSAC)
# Intranet Attendance & Governance System - Environment Config
# ==========================================================

# Port Configuration
FRONTEND_PORT=80
BACKEND_PORT=5000

# Node Environment
NODE_ENV=production

# Security & Secrets
JWT_SECRET=assac_production_super_secret_key_2026

# Storage Paths (Inside Container)
DB_DIR=/app/data
UPLOADS_DIR=/app/uploads

# Host Storage Mount Configuration for IMS Server (1.0TB on /data partition)
# Map to host's /data/uploads partition to use the 1TB available disk space:
# STORAGE_VOLUME_PATH=/data/uploads
# DATA_VOLUME_PATH=/data/attendance-system/data

# Optional: SMTP Mail Configuration (leave empty for mock mode)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=notifications@assac.assam.gov.in
# SMTP_PASS=your_email_password
# SMTP_FROM=ASSAC Notifications <notifications@assac.assam.gov.in>

# Cloudflare Workers AI Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
